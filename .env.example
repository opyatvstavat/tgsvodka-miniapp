# Telethon user account
API_ID=12345678
API_HASH=your_api_hash
SESSION_NAME=session_name
# Generate locally: python scripts/export_session.py
SESSION_STRING=
# Only one session is needed now that ingest runs inside web.
# Resolved as SESSION_STRING -> WORKER_SESSION_STRING -> WEB_SESSION_STRING.
# The same session must not be used from two IPs at once (Railway + local Docker).
WEB_SESSION_STRING=
WORKER_SESSION_STRING=

# Channels (@username or numeric id)
TARGET_CHANNEL=@your_summary_channel
HIGHLIGHTS_CHANNEL=@your_highlights_channel
OWN_CHANNELS=your_channel1,your_channel2

# Numeric chat ids for Bot API copyMessage (e.g. -1001234567890)
SUMMARY_CHAT_ID=-1001234567890
HIGHLIGHTS_CHAT_ID=-1001234567890

# Bot + Mini App
BOT_TOKEN=123456:ABC-DEF
WEBAPP_URL=https://your-app.up.railway.app
# Set to let only this user in; leave empty to open the feed to everyone
ALLOWED_USER_ID=
# Owner of the service account: comments, highlights, /stats. Defaults to ALLOWED_USER_ID.
OWNER_USER_ID=123456789
# Old pipeline: repost into TARGET_CHANNEL and ingest the copy. Off = save posts straight from channels.
SUMMARY_MIRROR=false
# Channels a free user may add; slots the service account may fill (Telegram caps it at 500)
FREE_CHANNEL_LIMIT=20
MAX_SERVICE_CHANNELS=450
# Seconds between channel joins; faster gets the account FloodWait-ed
JOIN_INTERVAL=120
# Leave a channel the service joined once nobody has read it for this many days
LEAVE_AFTER_DAYS=7

# Database. Leave DATABASE_URL empty to use SQLite on the mounted volume
# (SQLITE_PATH), which is what production runs. Set it to a postgresql:// URL
# to use Postgres instead.
DATABASE_URL=
SQLITE_PATH=/data/tgsvodka.db

# Backfill: import only the newest N posts from summary channel (live ingest adds all new posts)
BACKFILL_LIMIT=1000

# Optional extra channels to hide from feed (comma-separated usernames/titles, e.g. ph)
EXCLUDED_FEED_CHANNELS=

# Media cache. On Railway point MEDIA_CACHE_DIR at a mounted volume, otherwise the
# cache is wiped on every deploy and everything is re-downloaded from Telegram.
MEDIA_CACHE_DIR=/data/media
# Влияет на счёт: прочитанные файлы оседают в page cache, который Railway
# считает как память контейнера
MEDIA_CACHE_MAX_MB=200

# Telethon keepalive interval, seconds
FORCE_UPDATE_INTERVAL=300

# Backfill is a safety net for downtime, not the ingest path; a full pass is not cheap
BACKFILL_INTERVAL=3600
